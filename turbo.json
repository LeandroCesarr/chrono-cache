{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "cache": false
    },
    "publish": {
      "dependsOn": ["^publish", "build"]
    },
    "test:ui": {
      "dependsOn": ["^test:ui"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
